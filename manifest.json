{
  "manifest_version": 3,
  "name": "ECIJA Dataverse Naming",
  "version": "1.3.1",
  "description": "Genera el nombre lógico de columnas y opciones globales de Dataverse según el estándar ECIJA (snake_case + sufijo por tipo).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://make.powerapps.com/*", "https://make.preview.powerapps.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ECIJA Dataverse Naming",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options/options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://make.powerapps.com/*", "https://make.preview.powerapps.com/*"],
      "js": ["src/naming.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
